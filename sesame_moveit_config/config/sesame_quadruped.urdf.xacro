<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="sesame_quadruped">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import sesame_quadruped urdf file -->
    <xacro:include filename="$(find sesame_description)/urdf/sesame.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="sesame_quadruped.ros2_control.xacro" />


    <xacro:sesame_quadruped_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
